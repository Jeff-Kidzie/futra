# =============================================================================
# Futra Dashboard — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# =============================================================================

# --- MetaTrader 5 Connection ---
# Path to MT5 terminal executable
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# MT5 account credentials
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Server

# --- Dashboard ---
# Set to "true" for local development (enables CORS *, Vite proxy)
FUTRA_DASHBOARD_DEV=false
# Domain name for production HTTPS (Caddy will auto-provision Let's Encrypt)
FUTRA_DASHBOARD_DOMAIN=dashboard.yourdomain.com
# Path to SvelteKit production build
FUTRA_FRONTEND_DIR=frontend/build
# Polling interval for live MT5 data (seconds)
FUTRA_DASHBOARD_POLL=1.0

# --- Authentication ---
# Session token expiry (hours)
FUTRA_SESSION_EXPIRY_HOURS=24
# Secret for token generation — CHANGE THIS in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FUTRA_SESSION_SECRET=change_me_to_random_64_hex_chars

# --- Alerts ---
# Drawdown alert threshold (percentage)
FUTRA_DRAWDOWN_ALERT_PCT=10.0
# Daily loss alert threshold (USD)
FUTRA_DAILY_LOSS_ALERT=500.0

# --- AI Engine (Phase 2) ---
# Directory for AI decision logs
FUTRA_AI_LOG_DIR=logs/ai
# Directory for strategy configuration exports
FUTRA_STRATEGY_CONFIG_DIR=configs/strategies

# --- Data ---
# IPC directory for EA-Python communication
FUTRA_IPC_DIR=ipc
# Dashboard database (SQLite)
FUTRA_DASHBOARD_DB=dashboard.db
# Initial account balance for equity curve computation
FUTRA_INITIAL_BALANCE=10000.0

# --- Paper Trading (Phase 3) ---
# Demo account credentials for paper trading (separate from live MT5_LOGIN above).
# Required by BACK-05; consumed by python/config.py:85-87.
MT5_DEMO_LOGIN=12345678
MT5_DEMO_PASSWORD=your_demo_password
MT5_DEMO_SERVER=YourBroker-Demo
